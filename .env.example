# --- Telegram ---
TELEGRAM_BOT_TOKEN=isi_token_botfather

# --- App ---
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://domainmu.com
ORDER_EXPIRY_MINUTES=15
LOG_LEVEL=info

# --- Database (compose uses service names; bare VPS uses localhost) ---
# Docker compose:
# DATABASE_URL=postgres://ppob_user:password_kuat@postgres:5432/ppob_bot
# Bare VPS:
# DATABASE_URL=postgres://ppob_user:password_kuat@localhost:5432/ppob_bot
DATABASE_URL=postgres://ppob_user:password_kuat@postgres:5432/ppob_bot
PG_POOL_MAX=10
# optional: PGSSLMODE=require  (for managed Postgres)

# --- Redis ---
# Docker compose without password: REDIS_URL=redis://redis:6379
# Docker compose with password:    REDIS_URL=redis://:password_kuat@redis:6379
REDIS_URL=redis://redis:6379
#REDIS_PASSWORD=ganti_password_redis

# --- Provider transaksi (pilih salah satu) ---
# digiflazz = default PPOB, tokovoucher = voucher game
TRANSACTION_PROVIDER=digiflazz

# --- Digiflazz ---
DIGIFLAZZ_USERNAME=isi_username_digiflazz
DIGIFLAZZ_API_KEY=isi_api_key_digiflazz
DIGIFLAZZ_WEBHOOK_SECRET=isi_secret_webhook_digiflazz
DIGIFLAZZ_TESTING=false

# --- TokoVoucher (isi jika TRANSACTION_PROVIDER=tokovoucher) ---
# Dapatkan di https://member.tokovoucher.net/pengaturan/secret-key
TOKOVOUCHER_MEMBER_CODE=isi_member_code_tokovoucher
TOKOVOUCHER_SECRET=isi_secret_tokovoucher
# Whitelist IP VPS di https://member.tokovoucher.net/pengaturan/ip-whitelist

# --- Payment Gateway (Duitku) ---
PAYMENT_GATEWAY=duitku
PAYMENT_MOCK=false
DUITKU_MERCHANT_CODE=isi_merchant_code_duitku
DUITKU_MERCHANT_KEY=isi_merchant_key_duitku
DUITKU_MODE=production

# --- Admin (owner) — daftar telegram_id dipisah koma ---
ADMIN_IDS=123456789,987654321

# --- Rate limit (opsional, default sudah aman) ---
WEBHOOK_RATELIMIT_WINDOW_MS=60000
WEBHOOK_RATELIMIT_MAX=60
