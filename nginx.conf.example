# Example Nginx reverse proxy for ppob-bot
# Place at /etc/nginx/sites-available/ppob-bot and symlink to sites-enabled
# Requires certbot: sudo certbot --nginx -d domainmu.com

upstream ppob_bot {
    server 127.0.0.1:3000;
}

server {
    listen 80;
    server_name domainmu.com;

    # Let's Encrypt challenge
    location /.well-known/acme-challenge/ { root /var/www/html; }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name domainmu.com;

    # Managed by certbot — cert paths auto-inserted after certbot --nginx
    # ssl_certificate /etc/letsencrypt/live/domainmu.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/domainmu.com/privkey.pem;

    # Security headers (also set by helmet, but defense in depth at proxy)
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    client_max_body_size 32k;

    location /webhook/ {
        proxy_pass http://ppob_bot;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # health checks — allow without extra logging if desired
    location = /healthz { proxy_pass http://ppob_bot; }
    location = /readyz  { proxy_pass http://ppob_bot; }

    # Landing page + static (served by Node /public) — ganti 404 menjadi proxy ke "/"
    location / {
        proxy_pass http://ppob_bot;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
